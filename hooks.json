[
    {
    "id": "fonts",
    "execute-command": "/usr/bin/make",
    "command-working-directory": "/app",
    "pass-arguments-to-command": [
      {
        "source": "string",
        "name": "fonts"
      }
    ],
    "include-command-output-in-response": true
    },
    {
    "id": "burn",
    "execute-command": "/usr/bin/make",
    "command-working-directory": "/app",
    "pass-arguments-to-command": [
        { "source": "string", "name": "process" }
    ],
    "pass-environment-to-command": [
        {
        "source": "payload",
        "name": "ass",
        "envname": "RAW_ASS_CONTENT" 
        },
        {
        "source": "payload",
        "name": "id",
        "envname": "ID"
        },
        {
        "source": "payload",
        "name": "url",
        "envname": "URL"
        }
    ],
    "include-command-output-in-response": true
    }
]